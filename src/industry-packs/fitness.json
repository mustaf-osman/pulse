        "source": "运营机会",
        "title": "短视频训练打卡带来引流机会。"
      }
    ],
    "opportunities": [
      {
        "title": "到期前 14 天续费",
        "hint": "按剩余课时和训练目标提前启动续费关怀。"
      },
      {
        "title": "沉睡会员低门槛召回",
        "hint": "用体测复盘/免费纠姿替代硬促销。"
      }
    ],
    "trends": [
      {
        "keyword": "普拉提",
        "change": 0.22,
        "period": "7d"
      },
      {
        "keyword": "私教续费",
        "change": 0.18,
        "period": "7d"
      },
      {
        "keyword": "体态改善",
        "change": 0.15,
        "period": "7d"
      }
    ]
  },
  "prompts": [
    {
      "id": "weekly_training_plan",
      "title": "一周训练计划",
      "category": "训练",
      "template": "目标：{{goal}}；基础：{{level}}；每周训练 {{days}} 天；器械：{{equipment}}；限制：{{limitations}}。请生成一周训练计划，包含动作、组数、次数、休息和注意事项。",
      "vars": [
        "goal",
        "level",
        "days",
        "equipment",
        "limitations"
      ]
    },
    {
      "id": "meal_structure",
      "title": "饮食结构建议",
      "category": "饮食",
      "template": "我的目标是 {{goal}}，日常饮食习惯是 {{diet_habit}}，外食频率 {{eat_out}}。请给出饮食结构、样例三餐和外食选择。",
      "vars": [
        "goal",
        "diet_habit",
        "eat_out"
      ]
    },
    {
      "id": "movement_explain",
      "title": "动作讲解",
      "category": "动作",
      "template": "请讲解 {{movement}}：目标肌群、动作步骤、常见错误、发力提示、替代动作和安全提醒。",
      "vars": [
        "movement"
      ]
    }
  ],
  "dashboard": {
    "widgets": [
      {
        "type": "calendar",
        "title": "训练计划日历"
      },
      {
        "type": "trend",
        "title": "体重/围度趋势",
        "groupby": "fitness_goal"
      },
      {
        "type": "alert",
        "title": "伤病风险提醒"
      }
    ]
  },
