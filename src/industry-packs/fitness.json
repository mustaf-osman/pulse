{
  "id": "fitness",
  "name": "健身运动",
  "icon": "🏋️",
  "tagline": "训练计划、饮食建议、动作指导和进度复盘工作台。",
  "category": "store_ops",
  "order": 120,
  "assistantTitle": "健身服务助手",
  "assistantTagline": "懂训练 · 懂饮食 · 懂进度复盘",
  "themeColor": {
    "primary": "#22c55e",
    "glow": "rgba(34,197,94,0.18)",
    "bg_tint": "rgba(34,197,94,0.04)"
  },
  "aiPersona": "你是一位健身训练和运动计划助手，适合个人健身、私教工作室和健身房使用。你可以做训练计划、饮食结构建议、动作注意事项、进度复盘和会员沟通，但不做医疗诊断、不保证减脂增肌结果、不建议滥用药物或极端节食。",
  "hotspotSources": [
    "xiaohongshu_fitness",
    "douyin_hot",
    "weibo_hot"
  ],
  "customerFields": [
    {
      "key": "member_name",
      "label": "用户/会员姓名",
      "type": "text",
      "required": true
    },
    {
      "key": "fitness_goal",
      "label": "训练目标",
      "type": "tags",
      "options": [
        "减脂",
        "增肌",
        "塑形",
        "力量提升",
        "跑步",
        "体态改善",
        "康复后恢复"
      ]
    },
    {
      "key": "training_level",
      "label": "训练基础",
      "type": "select",
      "options": [
        "零基础",
        "初级",
        "中级",
        "高级"
      ]
    },
    {
      "key": "available_days",
      "label": "每周可训练天数",
      "type": "select",
      "options": [
        "1-2 天",
        "3 天",
        "4 天",
        "5 天+"
      ]
    },
    {
      "key": "limitations",
      "label": "限制/不适",
      "type": "tags",
      "options": [
        "膝盖不适",
        "腰背不适",
        "肩颈不适",
        "时间少",
        "器械有限",
        "饮食难控制"
      ]
    },
    {
      "key": "stage",
      "label": "阶段",
      "type": "select",
      "options": [
        "体测评估",
        "计划制定",
        "执行中",
        "复盘调整",
        "续费/服务"
      ],
      "required": true
    }
  ],
  "quickActions": [
    {
      "title": "生成训练计划",
      "description": "按目标和基础安排周计划",
      "action": "go-chat",
      "prompt": "请作为健身教练，先确认我的目标、训练基础、每周可训练天数、器械条件和伤病限制，然后生成一份安全的周训练计划。"
    },
    {
      "title": "饮食结构建议",
      "description": "餐盘比例和外食选择",
      "action": "go-chat",
      "prompt": "请根据我的健身目标，给出饮食结构建议：蛋白、碳水、脂肪、蔬菜、水分和外食替代方案，不要极端节食。"
    },
    {
      "title": "动作指导",
      "description": "发力、常见错误和安全提醒",
      "action": "go-chat",
      "prompt": "请讲解一个训练动作的正确做法、目标肌群、常见错误、发力提示和不适时的处理原则。"
    },
    {
      "title": "进度复盘",
      "description": "根据记录调整计划",
      "action": "go-chat",
      "prompt": "请根据我的训练记录、体重围度变化、疲劳感和饮食执行情况，做一次健身进度复盘，并给出下周调整。"
    }
  ],
  "radar": {
    "hotspots": [
      {
        "source": "行业趋势",
        "title": "普拉提、体态改善和女性力量训练内容升温。"
      },
      {
        "source": "客户需求",
        "title": "低频会员唤醒和私教续费成为门店重点。"
      },
